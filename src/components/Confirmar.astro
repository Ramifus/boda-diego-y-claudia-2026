---
const WHATSAPP_URL = `https://wa.me/59176205218?text=${encodeURIComponent("Me complace confirmar mi asistencia a la boda de Diego y Claudia. Nos vemos el sábado 22 de agosto. ¡Estaré sin falta!")}`;
---

<section class="relative w-full" style="background-color: #ffffff;">

  <!-- Flores arriba (volteadas) -->
  <img id="conf-flores-top"
    src="/imagenes/flores.png" alt="" aria-hidden="true"
    class="absolute left-0 right-0 w-full pointer-events-none select-none"
    style="top: -30px; transform: scaleY(-1); z-index: 20;"
    loading="eager"
  />

  <!-- Flores abajo -->
  <img id="conf-flores-bot"
    src="/imagenes/flores.png" alt="" aria-hidden="true"
    class="absolute left-0 right-0 w-full pointer-events-none select-none"
    style="bottom: -30px; z-index: 20;"
    loading="eager"
  />

  <!-- Contenido -->
  <div id="conf-seccion" class="relative flex flex-col items-center text-center pt-20 pb-24 px-8">

    <!-- Título -->
    <h2 id="conf-titulo"
      class="font-crimson uppercase tracking-[0.2em] mb-4"
      style="font-size: clamp(1.3rem, 6vw, 1.7rem); font-weight: 700; color: #C9A545; line-height: 1.4;"
    >
      Querida Familia<br/>y Amigos
    </h2>

    <!-- Corazón -->
    <div id="conf-corazon" class="mb-5" style="font-size: 1.6rem; color: #C9A545;">♥</div>

    <!-- Separador -->
    <div id="conf-sep" class="mb-6" style="height: 1px; width: 6rem; background-color: #F2D5DC;"></div>

    <!-- Texto principal -->
    <p id="conf-texto"
      class="font-raleway mb-6"
      style="font-size: clamp(0.95rem, 4.5vw, 1.1rem); font-weight: 300; color: #C27587; line-height: 1.9; max-width: 320px;"
    >
      Nos llena de felicidad poder compartir con ustedes este momento tan único y especial.
      Con la esperanza de que hagamos de este día un recuerdo inolvidable.
      Los esperamos con los corazones llenos de emoción, listos para celebrar el amor
      y crear memorias que permanezcan siempre en nuestros corazones.
    </p>

    <!-- Texto italic -->
    <p id="conf-italic"
      class="font-great-vibes mb-3"
      style="font-size: clamp(1.5rem, 7vw, 2rem); color: #C9A545;"
    >
      Esperamos contar con tu presencia
    </p>

    <!-- Instrucción -->
    <p id="conf-instruccion"
      class="font-raleway mb-7"
      style="font-size: clamp(0.8rem, 3.5vw, 0.9rem); font-weight: 300; color: #C27587; opacity: 0.8;"
    >
      Por favor, confirma tu asistencia haciendo clic en el botón
    </p>

    <!-- Botón WhatsApp -->
    <div id="conf-btn-wrap" class="relative w-full flex items-center justify-center" style="padding: 0 24px;">
      <img src="/imagenes/flor2.png" alt="" aria-hidden="true" class="pointer-events-none select-none absolute" style="width:60px; height:60px; object-fit:contain; left:0; z-index:10; transform: rotate(90deg);" />
      <a id="conf-btn"
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center rounded-full py-3 px-6 font-raleway transition-all hover:opacity-85 active:scale-95"
        style="background-color: #C27587; color: #fff; font-size: clamp(0.9rem, 4vw, 1.05rem); font-weight: 400; letter-spacing: 0.06em; text-decoration: none;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width:24px; height:24px; flex-shrink:0; margin-right:18px; filter: brightness(0) invert(1);">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Confirmar Asistencia
      </a>
      <img src="/imagenes/flor2.png" alt="" aria-hidden="true" class="pointer-events-none select-none absolute" style="width:60px; height:60px; object-fit:contain; right:0; z-index:10; transform: rotate(-90deg);" />
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";

  const seccion = document.getElementById("conf-seccion");

  gsap.set("#conf-seccion",     { opacity: 0, y: 50 });
  gsap.set("#conf-flores-top",  { opacity: 0, y: -40 });
  gsap.set("#conf-flores-bot",  { opacity: 0, y: 40 });
  gsap.set("#conf-titulo",      { opacity: 0, y: 25 });
  gsap.set("#conf-corazon",     { opacity: 0, scale: 0 });
  gsap.set("#conf-sep",         { opacity: 0, scaleX: 0 });
  gsap.set("#conf-texto",       { opacity: 0, y: 25 });
  gsap.set("#conf-italic",      { opacity: 0, y: 20 });
  gsap.set("#conf-instruccion", { opacity: 0, y: 15 });
  gsap.set("#conf-btn-wrap",    { opacity: 0, y: 20 });

  let lastY = window.scrollY, bajando = true;
  window.addEventListener("scroll", () => { bajando = window.scrollY >= lastY; lastY = window.scrollY; }, { passive: true });

  function resetConf() {
    gsap.set("#conf-seccion",     { opacity: 0, y: 50 });
    gsap.set("#conf-flores-top",  { opacity: 0, y: -40 });
    gsap.set("#conf-flores-bot",  { opacity: 0, y: 40 });
    gsap.set("#conf-titulo",      { opacity: 0, y: 25 });
    gsap.set("#conf-corazon",     { opacity: 0, scale: 0 });
    gsap.set("#conf-sep",         { opacity: 0, scaleX: 0 });
    gsap.set("#conf-texto",       { opacity: 0, y: 25 });
    gsap.set("#conf-italic",      { opacity: 0, y: 20 });
    gsap.set("#conf-instruccion", { opacity: 0, y: 15 });
    gsap.set("#conf-btn-wrap",    { opacity: 0, y: 20 });
  }

  new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) {
        if (e.boundingClientRect.top > 0) resetConf();
        return;
      }
      if (!bajando) return;
      const tl = gsap.timeline();
      tl.to("#conf-seccion",     { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0)
        .to("#conf-flores-top",  { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 0)
        .to("#conf-flores-bot",  { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 0)
        .to("#conf-titulo",      { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 0.2)
        .to("#conf-corazon",     { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(2)" }, 0.35)
        .to("#conf-sep",         { opacity: 1, scaleX: 1, duration: 0.6, ease: "power2.out", transformOrigin: "center" }, 0.4)
        .to("#conf-texto",       { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }, 0.5)
        .to("#conf-italic",      { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 0.7)
        .to("#conf-instruccion", { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.85)
        .to("#conf-btn-wrap",    { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 1);
    });
  }, { threshold: 0.1 }).observe(seccion!);
</script>
