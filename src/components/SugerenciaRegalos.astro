---

---

<!-- ═══════ TARJETA PRINCIPAL ═══════ -->
<section class="relative w-full flex items-center justify-center py-16 px-5">
  <div
    id="regalo-card"
    class="relative w-full max-w-xs mx-auto flex flex-col items-center text-center rounded-2xl shadow-2xl px-8 py-10"
    style="background-color: rgba(255,255,255,0.96);"
  >
    <!-- Título -->
    <h2
      id="regalo-titulo"
      class="font-crimson uppercase tracking-[0.2em] mb-5"
      style="font-size: clamp(1.1rem, 5vw, 1.4rem); font-weight: 700; color: #C9A545;"
    >
      Sugerencia de Regalos
    </h2>

    <!-- Ícono regalo -->
    <div id="regalo-icono" class="mb-5 flex items-center justify-center">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="#C9A545"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-16 h-16"
      >
        <path d="M20 12v10H4V12"></path>
        <path d="M22 7H2v5h20V7z"></path>
        <path d="M12 22V7"></path>
        <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"></path>
      </svg>
    </div>

    <!-- Línea separadora -->
    <div
      id="regalo-sep"
      class="w-full mb-5"
      style="height: 1px; background-color: #F2D5DC;"
    >
    </div>

    <!-- Descripción -->
    <p
      id="regalo-desc"
      class="font-raleway mb-7"
      style="font-size: clamp(0.95rem, 4.5vw, 1.1rem); font-weight: 300; color: #C27587; letter-spacing: 0.02em; line-height: 1.6;"
    >
      Un detalle especial<br />para celebrar con nosotros
    </p>

    <!-- Botón -->
    <button
      id="btn-regalo-abrir"
      class="w-full flex items-center justify-center rounded-full py-3 px-6 font-raleway transition-all hover:opacity-85 active:scale-95"
      style="background-color: #C27587; color: #fff; font-size: clamp(0.9rem, 4vw, 1.05rem); font-weight: 400; letter-spacing: 0.06em; border: none; cursor: pointer; box-shadow: 0 4px 15px rgba(194,117,135,0.4);"
    >
      Ver opciones
    </button>
  </div>
</section>

<!-- ═══════ MODAL ═══════ -->
<div
  id="modal-regalo"
  class="fixed inset-0 flex items-center justify-center z-[99999] px-5"
  style="display: none !important; background-color: rgba(0,0,0,0.65); backdrop-filter: blur(4px);"
>
  <div class="relative w-full max-w-xs mx-auto" style="max-height: 90vh;">
    <!-- Flores arriba detrás del card -->
    <img
      src="/imagenes/flores.png"
      alt=""
      aria-hidden="true"
      class="absolute left-0 right-0 w-full pointer-events-none select-none"
      style="top: 0; transform: scaleY(-1); z-index: 0;"
    />

    <!-- Círculo con ícono regalo -->
    <div
      class="absolute left-1/2 flex items-center justify-center rounded-full"
      style="width: 5rem; height: 5rem;
             background-color: #fff; border: 2px solid #C9A545;
             box-shadow: 0 4px 16px rgba(201,165,69,0.25);
             transform: translateX(-50%);
             top: 42px; z-index: 5;"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="#C9A545"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-9 h-9"
      >
        <path d="M20 12v10H4V12"></path>
        <path d="M22 7H2v5h20V7z"></path>
        <path d="M12 22V7"></path>
        <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"></path>
      </svg>
    </div>

    <!-- Card blanco -->
    <div
      class="relative flex flex-col items-center text-center rounded-2xl"
      style="background-color: #fffaf7; z-index: 1; margin-top: 70px;
             max-height: calc(90vh - 70px); overflow-y: auto;
             border: 1.5px solid #C9A545; padding: 4.5rem 1.5rem 1.5rem;"
    >
      <!-- Botón cerrar -->
      <button
        id="btn-regalo-cerrar"
        class="absolute flex items-center justify-center rounded-full"
        style="top: 0.7rem; right: 0.7rem; width: 1.9rem; height: 1.9rem;
               background-color: #C27587; border: none; cursor: pointer; z-index: 20;"
        aria-label="Cerrar"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="#fff"
          stroke-width="2.5"
          stroke-linecap="round"
          class="w-3.5 h-3.5"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Título modal -->
      <h3
        class="font-crimson uppercase tracking-[0.18em] mb-3"
        style="font-size: clamp(1.1rem, 5vw, 1.35rem); font-weight: 700; color: #C9A545;"
      >
        Sugerencia de Regalo
      </h3>

      <!-- Separador con rombo -->
      <div class="flex items-center gap-2 mb-4 w-full justify-center">
        <div
          style="height: 1px; width: 3rem; background-color: #C9A545; opacity: 0.5;"
        >
        </div>
        <span style="color: #C9A545; font-size: 0.5rem;">◆</span>
        <div
          style="height: 1px; width: 3rem; background-color: #C9A545; opacity: 0.5;"
        >
        </div>
      </div>

      <!-- Texto principal -->
      <p
        class="font-raleway mb-5"
        style="font-size: clamp(0.9rem, 4vw, 1rem); font-weight: 300; color: #C27587; line-height: 1.7; font-style: italic;"
      >
        El mejor regalo es tu presencia, pero si deseas tener un detalle con
        nosotros, te dejamos estas opciones
      </p>

      <!-- Card QR -->
      <div
        class="w-full rounded-2xl px-5 py-5 mb-5"
        style="background-color: #fff; border: 1px solid #F2D5DC;"
      >
        <p
          class="font-crimson uppercase tracking-[0.2em] mb-4"
          style="font-size: clamp(0.9rem, 4vw, 1.05rem); font-weight: 700; color: #C9A545;"
        >
          Transferencia QR
        </p>
        <img
          src="/imagenes/qr.png"
          alt="Código QR"
          class="w-40 h-40 mx-auto object-contain"
          loading="lazy"
        />
        <p
          class="font-raleway mt-3"
          style="font-size: clamp(0.8rem, 3.5vw, 0.9rem); font-weight: 300; color: #C27587; line-height: 1.6;"
        >
          Nombres cta.<br />Chavez Salcedo Dustin Diego
        </p>
      </div>

      <!-- Separador con rombo -->
      <div class="flex items-center gap-2 mb-4 w-full justify-center">
        <div
          style="height: 1px; width: 3rem; background-color: #C9A545; opacity: 0.5;"
        >
        </div>
        <span style="color: #C9A545; font-size: 0.5rem;">◆</span>
        <div
          style="height: 1px; width: 3rem; background-color: #C9A545; opacity: 0.5;"
        >
        </div>
      </div>

      <!-- Ícono sobre -->
      <!-- <div class="mb-3">
        <svg viewBox="0 0 24 24" fill="none" stroke="#C9A545" stroke-width="1.4"
          stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 mx-auto">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div> -->

      <!-- Texto buzón -->
      <!-- <p class="font-raleway"
        style="font-size: clamp(0.85rem, 3.5vw, 0.95rem); font-weight: 300; color: #C27587; line-height: 1.7; font-style: italic;">
        Si prefieres hacer un regalo en efectivo, habrá un buzón especial en la recepción
      </p> -->
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  const card = document.getElementById("regalo-card");

  gsap.set("#regalo-card", { opacity: 0, y: 50 });
  gsap.set("#regalo-titulo", { opacity: 0, scale: 0.85 });
  gsap.set("#regalo-icono", { opacity: 0, y: -20, scale: 0.7 });
  gsap.set("#regalo-sep", { opacity: 0, scaleX: 0 });
  gsap.set("#regalo-desc", { opacity: 0, y: 20 });
  gsap.set("#btn-regalo-abrir", { opacity: 0, y: 20 });

  let lastY = window.scrollY,
    bajando = true;
  window.addEventListener(
    "scroll",
    () => {
      bajando = window.scrollY >= lastY;
      lastY = window.scrollY;
    },
    { passive: true },
  );

  function resetRegalo() {
    gsap.set("#regalo-card", { opacity: 0, y: 50 });
    gsap.set("#regalo-titulo", { opacity: 0, scale: 0.85 });
    gsap.set("#regalo-icono", { opacity: 0, y: -20, scale: 0.7 });
    gsap.set("#regalo-sep", { opacity: 0, scaleX: 0 });
    gsap.set("#regalo-desc", { opacity: 0, y: 20 });
    gsap.set("#btn-regalo-abrir", { opacity: 0, y: 20 });
  }

  new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) {
          if (e.boundingClientRect.top > 0) resetRegalo();
          return;
        }
        if (!bajando) return;
        const tl = gsap.timeline();
        tl.to(
          "#regalo-card",
          { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" },
          0,
        )
          .to(
            "#regalo-titulo",
            { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" },
            0.1,
          )
          .to(
            "#regalo-icono",
            {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.7,
              ease: "back.out(1.5)",
            },
            0.2,
          )
          .to(
            "#regalo-sep",
            {
              opacity: 1,
              scaleX: 1,
              duration: 0.6,
              ease: "power2.out",
              transformOrigin: "left",
            },
            0.35,
          )
          .to(
            "#regalo-desc",
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
            0.45,
          )
          .to(
            "#btn-regalo-abrir",
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
            0.6,
          );
      });
    },
    { threshold: 0.2 },
  ).observe(card!);

  // Modal
  const modal = document.getElementById("modal-regalo");
  const btnAbrir = document.getElementById("btn-regalo-abrir");
  const btnCerrar = document.getElementById("btn-regalo-cerrar");

  btnAbrir?.addEventListener("click", () => {
    modal!.style.display = "flex";
    document.body.style.overflow = "hidden";
  });

  function cerrar() {
    modal!.style.display = "none";
    document.body.style.overflow = "";
  }

  btnCerrar?.addEventListener("click", cerrar);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) cerrar();
  });
</script>
