---
---

<!-- ═══════ TARJETA PRINCIPAL ═══════ -->
<section class="relative w-full flex items-center justify-center py-16 px-5">

  <div id="vest-card"
    class="relative w-full max-w-xs mx-auto flex flex-col items-center text-center rounded-2xl shadow-2xl px-8 py-10"
    style="background-color: rgba(255,255,255,0.96);"
  >
    <h2 id="vest-titulo"
      class="font-crimson uppercase tracking-[0.2em] mb-5"
      style="font-size: clamp(1.1rem, 5vw, 1.4rem); font-weight: 700; color: #C9A545;"
    >Código de Vestimenta</h2>

    <img id="vest-corbata" src="/imagenes/corbata.png" alt="Corbata" class="corbata-icon mb-5 w-16 h-16 object-contain" />

    <div id="vest-sep" class="w-full mb-5" style="height: 1px; background-color: #F2D5DC;"></div>

    <p id="vest-desc"
      class="font-raleway mb-7"
      style="font-size: clamp(0.95rem, 4.5vw, 1.1rem); font-weight: 300; color: #C27587; letter-spacing: 0.02em;"
    >Una orientación para tu vestimenta</p>

    <button id="btn-ver-mas"
      class="w-full flex items-center justify-center rounded-full py-3 px-6 font-raleway transition-all hover:opacity-85 active:scale-95"
      style="background-color: #C27587; color: #fff; font-size: clamp(0.9rem, 4vw, 1.05rem); font-weight: 400; letter-spacing: 0.06em; border: none; cursor: pointer; box-shadow: 0 4px 15px rgba(194,117,135,0.4);"
    >
      Ver más
    </button>

  </div>
</section>

<!-- ═══════ MODAL ═══════ -->
<div
  id="modal-vestimenta"
  class="fixed inset-0 flex items-center justify-center z-[99999] px-5"
  style="display: none !important; background-color: rgba(0,0,0,0.65); backdrop-filter: blur(4px);"
>
  <div class="relative w-full max-w-xs mx-auto" style="max-height: 90vh;">

    <!-- Flores arriba detrás del card -->
    <img src="/imagenes/flores.png" alt="" aria-hidden="true"
      class="absolute left-0 right-0 w-full pointer-events-none select-none"
      style="top: 0; transform: scaleY(-1); z-index: 0;"
    />

    <!-- Círculo con corbata -->
    <div class="absolute left-1/2 flex items-center justify-center rounded-full"
      style="width: 5rem; height: 5rem;
             background-color: #fff; border: 2px solid #C9A545;
             box-shadow: 0 4px 16px rgba(201,165,69,0.25);
             transform: translateX(-50%);
             top: 42px; z-index: 5;">
      <img src="/imagenes/corbata.png" alt="Corbata"
        class="corbata-icon w-10 h-10 object-contain" />
    </div>

    <!-- Card blanco -->
    <div
      class="relative flex flex-col items-center text-center rounded-2xl"
      style="background-color: #fffaf7; z-index: 1; margin-top: 70px;
             max-height: calc(90vh - 70px); overflow-y: auto;
             border: 1.5px solid #C9A545; padding: 4.5rem 1.5rem 1.5rem;"
    >

      <!-- Botón cerrar -->
      <button
        id="btn-cerrar-modal"
        class="absolute flex items-center justify-center rounded-full"
        style="top: 0.7rem; right: 0.7rem; width: 1.9rem; height: 1.9rem;
               background-color: #C27587; border: none; cursor: pointer; z-index: 20;"
        aria-label="Cerrar"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"
          stroke-linecap="round" class="w-3.5 h-3.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>

      <!-- Título -->
      <h3 class="font-crimson uppercase tracking-[0.18em] mb-3"
        style="font-size: clamp(1.1rem, 5vw, 1.35rem); font-weight: 700; color: #C9A545;">
        Código de Vestimenta
      </h3>

      <!-- Separador con rombo -->
      <div class="flex items-center gap-2 mb-4 w-full justify-center">
        <div style="height: 1px; width: 3rem; background-color: #C9A545; opacity: 0.5;"></div>
        <span style="color: #C9A545; font-size: 0.5rem;">◆</span>
        <div style="height: 1px; width: 3rem; background-color: #C9A545; opacity: 0.5;"></div>
      </div>

      <!-- Imagen vestimenta -->
      <img src="/imagenes/vestimenta.webp" alt="Código de vestimenta"
        class="mb-3"
        style="object-fit: contain; width: 35%; max-height: 70px;"
        loading="lazy"
      />

      <!-- "Formal" -->
      <p class="font-great-vibes mb-2"
        style="font-size: clamp(2rem, 9vw, 2.6rem); color: #C9A545;">
        Formal
      </p>

      <!-- Descripción -->
      <p class="font-raleway mb-5"
        style="font-size: clamp(0.85rem, 3.5vw, 0.95rem); color: #C27587; font-weight: 300; letter-spacing: 0.03em;">
        El color blanco y los tonos en rosa están reservados para los novios
      </p>

      <!-- Flores abajo -->
      <img src="/imagenes/flor2.png" alt="" aria-hidden="true"
        class="pointer-events-none select-none"
        style="width: 40%; margin-bottom: -8px;"
        loading="lazy"
      />

    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  const card = document.getElementById("vest-card");

  gsap.set("#vest-titulo",  { opacity: 0, scale: 0.85 });
  gsap.set("#vest-corbata", { opacity: 0, y: -25, rotation: -15 });
  gsap.set("#vest-sep",     { opacity: 0, scaleX: 0 });
  gsap.set("#vest-desc",    { opacity: 0, y: 20 });
  gsap.set("#btn-ver-mas",  { opacity: 0, y: 20 });

  let lastY = window.scrollY, bajando = true;
  window.addEventListener("scroll", () => { bajando = window.scrollY >= lastY; lastY = window.scrollY; }, { passive: true });

  function resetVest() {
    gsap.set("#vest-card",    { opacity: 0, y: 50 });
    gsap.set("#vest-titulo",  { opacity: 0, scale: 0.85 });
    gsap.set("#vest-corbata", { opacity: 0, y: -25, rotation: -15 });
    gsap.set("#vest-sep",     { opacity: 0, scaleX: 0 });
    gsap.set("#vest-desc",    { opacity: 0, y: 20 });
    gsap.set("#btn-ver-mas",  { opacity: 0, y: 20 });
  }

  new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) {
        if (e.boundingClientRect.top > 0) resetVest();
        return;
      }
      if (!bajando) return;
      const tl = gsap.timeline();
      tl.to("#vest-card",    { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0)
        .to("#vest-titulo",  { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" }, 0)
        .to("#vest-corbata", { opacity: 1, y: 0, rotation: 0, duration: 0.8, ease: "back.out(1.5)" }, 0.15)
        .to("#vest-sep",     { opacity: 1, scaleX: 1, duration: 0.6, ease: "power2.out", transformOrigin: "left" }, 0.3)
        .to("#vest-desc",    { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.45)
        .to("#btn-ver-mas",  { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.6);
    });
  }, { threshold: 0.2 }).observe(card!);
</script>

<style>
  /* Colorea la corbata al tono dorado #b8956a */
  .corbata-icon {
    filter: brightness(0) saturate(100%) invert(65%) sepia(35%) saturate(500%) hue-rotate(5deg) brightness(95%);
  }
</style>

<script>
  const btnVerMas     = document.getElementById("btn-ver-mas");
  const modal         = document.getElementById("modal-vestimenta");
  const btnCerrar     = document.getElementById("btn-cerrar-modal");

  btnVerMas?.addEventListener("click", () => {
    modal!.style.display = "flex";
    document.body.style.overflow = "hidden";
  });

  function cerrarModal() {
    modal!.style.display = "none";
    document.body.style.overflow = "";
  }

  btnCerrar?.addEventListener("click", cerrarModal);

  // Cerrar al tocar fuera del card
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) cerrarModal();
  });
</script>
