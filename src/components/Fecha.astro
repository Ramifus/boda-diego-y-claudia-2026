---
// Datos de la ceremonia
const DIA_NOMBRE = "SÁBADO";
const MES = "AGOSTO";
const DIA_NUM = "22";
const HORA = "1:00 PM";
const ANO = "2026";
const LUGAR = "Lion Palace Convention Center.";
const DIRECCION = "Calle Linares N° 1017";
const MAPS_URL = "https://maps.app.goo.gl/qiYPpveC8x6ap4UW8";
---

<section class="relative w-full flex items-center justify-center py-16 px-5">
  <!-- Tarjeta blanca -->
  <div
    id="fecha-card"
    class="relative w-full max-w-xs mx-auto flex flex-col items-center text-center rounded-2xl shadow-2xl px-8 py-10"
    style="background-color: rgba(255,255,255,0.96);"
  >
    <img
      id="fecha-anillos"
      src="/iconos/Anillos.png"
      alt="Anillos de boda"
      class="w-24 h-24 object-contain mb-4"
      loading="eager"
    />
    <h2
      id="fecha-titulo"
      class="font-crimson uppercase tracking-[0.25em] mb-4"
      style="font-size: clamp(1.3rem, 6vw, 1.7rem); font-weight: 700; color: #b8956a;"
    >
      Ceremonia
    </h2>
    <div
      id="fecha-sep1"
      class="w-full mb-4"
      style="height: 1px; background-color: #e0d5c5;"
    >
    </div>
    <p
      id="fecha-mes"
      class="font-raleway uppercase tracking-[0.3em] mb-3"
      style="font-size: clamp(0.95rem, 4vw, 1.1rem); color: #b8956a; font-weight: 300;"
    >
      {MES}
    </p>
    <div
      id="fecha-fila"
      class="flex items-center justify-center gap-4 w-full mb-1"
    >
      <span
        class="font-raleway uppercase tracking-widest"
        style="font-size: clamp(0.95rem, 4vw, 1.1rem); color: #b8956a; font-weight: 300;"
        >{DIA_NOMBRE}</span
      >
      <span
        class="font-crimson font-bold"
        style="font-size: clamp(3.8rem, 17vw, 5.5rem); color: #b8956a; line-height: 1;"
        >{DIA_NUM}</span
      >
      <span
        class="font-raleway"
        style="font-size: clamp(0.95rem, 4vw, 1.1rem); color: #b8956a; font-weight: 300;"
        >{HORA}</span
      >
    </div>
    <p
      id="fecha-ano"
      class="font-raleway mb-5"
      style="font-size: clamp(0.95rem, 4vw, 1.1rem); color: #b8956a; font-weight: 300; letter-spacing: 0.1em;"
    >
      {ANO}
    </p>
    <div
      id="fecha-sep2"
      class="w-full mb-5"
      style="height: 1px; background-color: #e0d5c5;"
    >
    </div>
    <p
      id="fecha-lugar"
      class="font-crimson mb-1"
      style="font-size: clamp(1.2rem, 5.5vw, 1.5rem); font-weight: 700; color: #2a2a2a;"
    >
      {LUGAR}
    </p>
    <p
      id="fecha-dir"
      class="font-raleway mb-1"
      style="font-size: clamp(1rem, 4.5vw, 1.2rem); font-weight: 300; color: #888; letter-spacing: 0.03em;"
    >
      {DIRECCION}
    </p>
    <p
      id="fecha-hora"
      class="font-raleway mb-6"
      style="font-size: clamp(1rem, 4.5vw, 1.2rem); font-weight: 300; color: #b8956a; letter-spacing: 0.05em;"
    >
      13:00 hs
    </p>
    <a
      id="fecha-btn"
      href={MAPS_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center rounded-full py-3 px-6 font-raleway transition-opacity hover:opacity-80 active:opacity-70"
      style="background-color: #b8956a; color: #fff; font-size: clamp(0.85rem, 4vw, 1rem); font-weight: 400; letter-spacing: 0.05em; text-decoration: none;"
    >
      ¿Cómo llegar?
    </a>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const card = document.getElementById("fecha-card");
  gsap.set("#fecha-card", { opacity: 0, y: 50 });
  gsap.set(["#fecha-anillos"], { opacity: 0, y: -30, scale: 0.7 });
  gsap.set("#fecha-titulo", { opacity: 0, scale: 0.8 });
  gsap.set(["#fecha-sep1", "#fecha-sep2"], { opacity: 0, scaleX: 0 });
  gsap.set(["#fecha-mes", "#fecha-ano"], { opacity: 0, y: 20 });
  gsap.set("#fecha-fila", { opacity: 0, scale: 0.85 });
  gsap.set(["#fecha-lugar", "#fecha-dir", "#fecha-hora"], {
    opacity: 0,
    y: 25,
  });
  gsap.set("#fecha-btn", { opacity: 0, y: 20 });

  let lastY = window.scrollY,
    bajando = true;
  window.addEventListener(
    "scroll",
    () => {
      bajando = window.scrollY >= lastY;
      lastY = window.scrollY;
    },
    { passive: true },
  );

  function resetFecha() {
    gsap.set("#fecha-card", { opacity: 0, y: 50 });
    gsap.set("#fecha-anillos", { opacity: 0, y: -30, scale: 0.7 });
    gsap.set("#fecha-titulo", { opacity: 0, scale: 0.8 });
    gsap.set(["#fecha-sep1", "#fecha-sep2"], { opacity: 0, scaleX: 0 });
    gsap.set(["#fecha-mes", "#fecha-ano"], { opacity: 0, y: 20 });
    gsap.set("#fecha-fila", { opacity: 0, scale: 0.85 });
    gsap.set(["#fecha-lugar", "#fecha-dir", "#fecha-hora"], {
      opacity: 0,
      y: 25,
    });
    gsap.set("#fecha-btn", { opacity: 0, y: 20 });
  }

  new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) {
          if (e.boundingClientRect.top > 0) resetFecha();
          return;
        }
        if (!bajando) return;
        const tl = gsap.timeline();
        tl.to(
          "#fecha-card",
          { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" },
          0,
        )
          .to(
            "#fecha-anillos",
            {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.8,
              ease: "back.out(1.5)",
            },
            0,
          )
          .to(
            "#fecha-titulo",
            { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" },
            0.15,
          )
          .to(
            ["#fecha-sep1", "#fecha-sep2"],
            {
              opacity: 1,
              scaleX: 1,
              duration: 0.6,
              ease: "power2.out",
              stagger: 0.15,
              transformOrigin: "left",
            },
            0.25,
          )
          .to(
            "#fecha-mes",
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
            0.35,
          )
          .to(
            "#fecha-fila",
            { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.3)" },
            0.45,
          )
          .to(
            "#fecha-ano",
            { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" },
            0.55,
          )
          .to(
            ["#fecha-lugar", "#fecha-dir", "#fecha-hora"],
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              ease: "power2.out",
              stagger: 0.08,
            },
            0.65,
          )
          .to(
            "#fecha-btn",
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
            0.85,
          );
      });
    },
    { threshold: 0.15 },
  ).observe(card!);
</script>
