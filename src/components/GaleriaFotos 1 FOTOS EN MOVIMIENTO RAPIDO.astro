---
const fotos = [
  "/imagenes/foto1.png",
  "/imagenes/foto2.png",
  "/imagenes/foto3.png",
  "/imagenes/foto4.png",
  "/imagenes/foto5.png",
  "/imagenes/foto6.png",
  "/imagenes/foto7.png",
  "/imagenes/foto8.png",
  "/imagenes/foto9.png",
];
---

<section class="relative w-full overflow-hidden" style="background-color: #ffffff;">

  <!-- Flores arriba (volteadas) -->
  <img
    src="/imagenes/flores.png"
    alt=""
    aria-hidden="true"
    class="absolute left-0 right-0 w-full pointer-events-none select-none"
    style="top: -50px; transform: scaleY(-1); z-index: 10;"
    loading="eager"
  />

  <!-- Flores abajo -->
  <img
    src="/imagenes/flores.png"
    alt=""
    aria-hidden="true"
    class="absolute left-0 right-0 w-full pointer-events-none select-none"
    style="bottom: -50px; z-index: 10;"
    loading="eager"
  />

  <!-- Contenido interior -->
  <div class="relative flex flex-col items-center pt-20 pb-20">

    <!-- Texto principal -->
    <div class="text-center px-8 mb-8">

      <h2
        class="font-great-vibes mb-3"
        style="font-size: clamp(2.4rem, 11vw, 3.5rem); color: #2a2a2a; line-height: 1.2;"
      >
        Retratos de nuestro amor
      </h2>

      <p
        class="font-raleway"
        style="font-size: clamp(0.9rem, 4vw, 1.05rem); color: #999; font-weight: 300; letter-spacing: 0.05em;"
      >
        La clave es disfrutar cada momento
      </p>

      <!-- Ícono cámara -->
      <div class="flex justify-center mt-5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#b8956a"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-10 h-10"
        >
          <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
      </div>
    </div>

    <!-- Carrusel auto-scroll -->
    <div class="w-full overflow-hidden" style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);">
      <div class="carrusel-track flex gap-4" style="width: max-content;">
        <!-- Fotos originales -->
        {fotos.map((src, i) => (
          <div
            class="carrusel-item flex-shrink-0 overflow-hidden rounded-2xl"
            style="width: 200px; height: 280px; box-shadow: 0 8px 30px rgba(0,0,0,0.15);"
          >
            <img
              src={src}
              alt={`Foto ${i + 1}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
        <!-- Duplicadas para loop infinito -->
        {fotos.map((src, i) => (
          <div
            class="carrusel-item flex-shrink-0 overflow-hidden rounded-2xl"
            style="width: 200px; height: 280px; box-shadow: 0 8px 30px rgba(0,0,0,0.15);"
          >
            <img
              src={src}
              alt={`Foto ${i + 1}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .carrusel-track {
    animation: scroll-left 28s linear infinite;
  }

  .carrusel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
