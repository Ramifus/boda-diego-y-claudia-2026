        <div style="height: 1px; width: 3.5rem; background: rgba(201,165,69,0.4);"></div>
        <span style="color: #C9A545; font-size: 0.4rem;">◆</span>
        <div style="height: 1px; width: 3.5rem; background: rgba(201,165,69,0.4);"></div>
      </div>
    </div>

    <div class="relative px-2">

      <!-- Línea central -->
      <div
