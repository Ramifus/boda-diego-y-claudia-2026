<style>
  .dorado-filter {
    filter: invert(75%) sepia(35%) saturate(650%) hue-rotate(5deg) brightness(97%);
    transition: filter 0.3s ease, transform 0.3s ease;
  }
  .evento-item img.dorado-filter:hover {
    transform: scale(1.1);
  }
  .corazon-item {
    filter: drop-shadow(0 3px 8px rgba(201,165,69,0.4));
    transition: transform 0.3s ease;
  }
  .corazon-item:hover {
    transform: scale(1.2) rotate(10deg);
  }
  .evento-item p:first-of-type {
    transition: transform 0.3s ease;
  }
  .evento-item:hover p:first-of-type {
    transform: scale(1.05);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const init = () => {
    gsap.set(".titulo-itinerario", { opacity: 0, y: -25 });
    gsap.set(".linea-central",     { opacity: 0, scaleY: 0 });
    gsap.set(".corazon-item",      { opacity: 0, scale: 0 });
    gsap.set(".evento-item",       { opacity: 0 });
    gsap.set(".imagen-izq, .texto-izq", { x: -50 });
    gsap.set(".imagen-der, .texto-der", { x: 50 });

    ScrollTrigger.create({
      trigger: ".titulo-itinerario",
      start: "top 88%",
      once: true,
      onEnter: () =>
        gsap.to(".titulo-itinerario", { opacity: 1, y: 0, duration: 1, ease: "power3.out" }),
    });

    ScrollTrigger.create({
      trigger: "#eventos-container",
      start: "top 82%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to(".linea-central", { opacity: 1, scaleY: 1, duration: 1.4, ease: "power2.out", transformOrigin: "top center" }, 0)
          .to(".corazon-item",  { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.7)", stagger: 0.05 }, 0)
          .to(".evento-item",   { opacity: 1, duration: 0.8, ease: "power3.out" }, 0)
          .to(".imagen-izq, .texto-izq", { x: 0, duration: 0.9, ease: "power3.out" }, 0)
          .to(".imagen-der, .texto-der", { x: 0, duration: 0.9, ease: "power3.out" }, 0);
      },
      onLeaveBack: () => {
        gsap.to(".linea-central, .corazon-item, .evento-item", { opacity: 0, duration: 0.3 });
        gsap.to(".linea-central", { scaleY: 0, duration: 0.3, transformOrigin: "top center" });
        gsap.to(".corazon-item",  { scale: 0, duration: 0.3 });
        gsap.to(".imagen-izq, .texto-izq", { x: -50, duration: 0.3 });
        gsap.to(".imagen-der, .texto-der", { x: 50,  duration: 0.3 });
      },
    });
  };

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>
