<section class="relative w-full flex items-center justify-center py-16 px-5">
  <div
    class="relative w-full max-w-xs mx-auto flex flex-col items-center rounded-2xl shadow-2xl px-6 py-10 overflow-hidden"
    style="background-color: rgba(255,255,255,0.96);"
