---
const fotos = [
  "/imagenes/foto1.png",
  "/imagenes/foto2.png",
  "/imagenes/foto3.png",
  "/imagenes/foto4.png",
  "/imagenes/foto5.png",
  "/imagenes/foto6.png",
  "/imagenes/foto7.png",
  "/imagenes/foto8.png",
  "/imagenes/foto9.png",
];

---

<section class="relative w-full" style="background-color: #ffffff;">

  <!-- Flores arriba -->
  <img id="gal-flores-top" src="/imagenes/flores.png" alt="" aria-hidden="true"
    class="absolute left-0 right-0 w-full pointer-events-none select-none"
    style="top: -30px; transform: scaleY(-1); z-index: 20;" loading="eager"/>

  <!-- Flores abajo -->
  <img id="gal-flores-bot" src="/imagenes/flores.png" alt="" aria-hidden="true"
    class="absolute left-0 right-0 w-full pointer-events-none select-none"
    style="bottom: -30px; z-index: 20;" loading="eager"/>

  <!-- Contenido interior -->
  <div id="gal-seccion" class="relative flex flex-col items-center pt-20 pb-24">

    <div class="text-center px-8 mb-10">
      <p id="gal-label"
        class="font-raleway uppercase tracking-[0.3em] mb-3"
        style="font-size: clamp(0.65rem, 3vw, 0.8rem); color: #C27587; font-weight: 300;"
      >Momentos especiales</p>

      <h2 id="gal-titulo"
        class="font-crimson uppercase tracking-[0.2em] mb-3"
        style="font-size: clamp(1.3rem, 6vw, 1.7rem); font-weight: 700; color: #C9A545;"
      >Retratos de nuestro amor</h2>

      <div id="gal-icono" class="flex items-center justify-center gap-3 mt-2">
        <div style="height:1px; width:3rem; background-color:#F2D5DC;"></div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="#C27587" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"
          class="w-6 h-6">
          <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
        <div style="height:1px; width:3rem; background-color:#F2D5DC;"></div>
      </div>

      <p
        class="font-raleway mt-3"
        style="font-size: clamp(1.1rem, 5vw, 1.3rem); color: #C27587; font-weight: 300; letter-spacing: 0.04em;"
      >
        La clave es disfrutar cada momento
      </p>
    </div>

    <!-- Carrusel elegante -->
    <div id="gal-carrusel"
      class="w-full overflow-hidden"
      style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); cursor: grab;"
    >
      <div id="carrusel-track" class="flex items-end gap-4" style="width: max-content; padding: 24px 16px;">

        <!-- Fotos originales -->
        {fotos.map((src, i) => (
          <div class="foto-item flex-shrink-0 overflow-hidden"
            style={`
              width: 175px;
              height: 260px;
              border-radius: 4px;
              box-shadow: 0 8px 32px rgba(0,0,0,0.22), 0 2px 8px rgba(0,0,0,0.1);
              border: 5px solid #fff;
              outline: 1px solid #e8ddd0;
              transition: transform 0.3s ease, box-shadow 0.3s ease;
            `}
          >
            <img src={src} alt={`Foto ${i + 1}`} class="w-full h-full object-cover" loading="lazy"/>
          </div>
        ))}

        <!-- Duplicadas para loop -->
        {fotos.map((src, i) => (
          <div class="foto-item flex-shrink-0 overflow-hidden"
            style={`
              width: 175px;
              height: 260px;
              border-radius: 4px;
              box-shadow: 0 8px 32px rgba(0,0,0,0.22), 0 2px 8px rgba(0,0,0,0.1);
              border: 5px solid #fff;
              outline: 1px solid #e8ddd0;
              transition: transform 0.3s ease, box-shadow 0.3s ease;
            `}
          >
            <img src={src} alt={`Foto ${i + 1}`} class="w-full h-full object-cover" loading="lazy"/>
          </div>
        ))}

      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  const seccion = document.getElementById("gal-seccion");

  gsap.set("#gal-flores-top", { opacity: 0, y: -40 });
  gsap.set("#gal-flores-bot", { opacity: 0, y: 40 });
  gsap.set("#gal-label",      { opacity: 0, y: 20 });
  gsap.set("#gal-titulo",     { opacity: 0, scale: 0.85 });
  gsap.set("#gal-icono",      { opacity: 0, scale: 0 });
  gsap.set("#gal-subtitulo",  { opacity: 0, y: 20 });
  gsap.set("#gal-carrusel",   { opacity: 0, y: 40 });

  let lastY = window.scrollY, bajando = true;
  window.addEventListener("scroll", () => { bajando = window.scrollY >= lastY; lastY = window.scrollY; }, { passive: true });

  function resetGal() {
    gsap.set("#gal-seccion",    { opacity: 0, y: 50 });
    gsap.set("#gal-flores-top", { opacity: 0, y: -40 });
    gsap.set("#gal-flores-bot", { opacity: 0, y: 40 });
    gsap.set("#gal-label",      { opacity: 0, y: 20 });
    gsap.set("#gal-titulo",     { opacity: 0, scale: 0.85 });
    gsap.set("#gal-icono",      { opacity: 0, scale: 0 });
    gsap.set("#gal-subtitulo",  { opacity: 0, y: 20 });
    gsap.set("#gal-carrusel",   { opacity: 0, y: 40 });
  }

  new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) {
        if (e.boundingClientRect.top > 0) resetGal();
        return;
      }
      if (!bajando) return;
      const tl = gsap.timeline();
      tl.to("#gal-seccion",    { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0)
        .to("#gal-flores-top", { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 0)
        .to("#gal-flores-bot", { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 0)
        .to("#gal-label",      { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 0.2)
        .to("#gal-titulo",     { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(1.4)" }, 0.3)
        .to("#gal-icono",      { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(2)" }, 0.45)
        .to("#gal-subtitulo",  { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.55)
        .to("#gal-carrusel",   { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 0.65);
    });
  }, { threshold: 0.1 }).observe(seccion!);
</script>

<script>
  import { gsap } from "gsap";

  const wrapper = document.getElementById("gal-carrusel") as HTMLElement;
  const track   = document.getElementById("carrusel-track") as HTMLElement;

  const SPEED   = 0.6; // px por frame
  let xPos      = 0;
  let paused    = false;
  let dragging  = false;
  let dragStartX = 0;
  let dragStartPos = 0;

  function halfWidth() { return track.scrollWidth / 2; }

  // Auto-scroll via GSAP ticker
  gsap.ticker.add(() => {
    if (paused || dragging) return;
    xPos -= SPEED;
    if (Math.abs(xPos) >= halfWidth()) xPos = 0;
    gsap.set(track, { x: xPos });
  });

  // Hover pause
  wrapper.addEventListener("mouseenter", () => paused = true);
  wrapper.addEventListener("mouseleave", () => { paused = false; wrapper.style.cursor = "grab"; });

  // Mouse drag
  wrapper.addEventListener("mousedown", (e) => {
    dragging = true;
    dragStartX = e.clientX;
    dragStartPos = xPos;
    wrapper.style.cursor = "grabbing";
  });
  window.addEventListener("mousemove", (e) => {
    if (!dragging) return;
    xPos = dragStartPos + (e.clientX - dragStartX);
    gsap.set(track, { x: xPos });
  });
  window.addEventListener("mouseup", () => { dragging = false; });

  // Touch drag
  wrapper.addEventListener("touchstart", (e) => {
    dragging = true;
    dragStartX = e.touches[0].clientX;
    dragStartPos = xPos;
  }, { passive: true });
  wrapper.addEventListener("touchmove", (e) => {
    if (!dragging) return;
    xPos = dragStartPos + (e.touches[0].clientX - dragStartX);
    gsap.set(track, { x: xPos });
  }, { passive: true });
  wrapper.addEventListener("touchend", () => { dragging = false; });

  // Hover scale en fotos
  track.querySelectorAll(".foto-item").forEach(item => {
    item.addEventListener("mouseenter", () => gsap.to(item, { scale: 1.03, duration: 0.3, ease: "power2.out" }));
    item.addEventListener("mouseleave", () => gsap.to(item, { scale: 1, duration: 0.3, ease: "power2.out" }));
  });
</script>

<style>
  #gal-carrusel { user-select: none; }
</style>
