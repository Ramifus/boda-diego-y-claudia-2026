---
const eventos = [
  { hora: "14:00", nombre: "Ceremonia Civil",        icon: "civil"      },
  { hora: "15:00", nombre: "Celebración",             icon: "fiesta"     },
  { hora: "15:30", nombre: "Baile de los Novios",     icon: "baile"      },
  { hora: "15:45", nombre: "Brindis",                 icon: "brindis"    },
  { hora: "16:00", nombre: "Almuerzo",                icon: "almuerzo"   },
  { hora: "17:00", nombre: "Corte de Torta",          icon: "torta"      },
  { hora: "17:15", nombre: "Fiesta y Baile",          icon: "baile"      },
  { hora: "21:00", nombre: "Bouquet",                 icon: "bouquet"    },
  { hora: "23:30", nombre: "Fin de la Fiesta",        icon: "despedida"  },
];
---

<section class="relative w-full flex items-center justify-center py-16 px-5">
  <div
    id="itin-card"
    class="relative w-full max-w-xs mx-auto flex flex-col items-center rounded-2xl shadow-2xl"
    style="background-color: rgba(255,255,255,0.96); padding: 2.5rem 1.75rem 2rem;"
  >
    <!-- Título -->
    <div id="itin-header" class="text-center w-full mb-7">
      <h2
        class="font-crimson uppercase tracking-[0.2em]"
        style="font-size: clamp(1.3rem, 6vw, 1.7rem); font-weight: 700; color: #C9A545;"
      >
        Itinerario
      </h2>
      <div class="flex items-center justify-center gap-2" style="margin-top: 0.5rem;">
        <div style="height: 1px; width: 3.5rem; background: rgba(201,165,69,0.4);"></div>
        <span style="color: #C9A545; font-size: 0.4rem;">◆</span>
        <div style="height: 1px; width: 3.5rem; background: rgba(201,165,69,0.4);"></div>
      </div>
    </div>

    <!-- Timeline -->
    <div class="relative w-full">

      <!-- Línea vertical -->
      <div
        class="absolute"
        style="left: 1.375rem; top: 1.375rem; bottom: 1rem; width: 1px;
               background: linear-gradient(to bottom,
                 rgba(201,165,69,0.75) 0%,
                 rgba(201,165,69,0.45) 80%,
                 transparent 100%);"
      ></div>

      {eventos.map((ev, i) => (
        <div class="itin-item relative flex items-start gap-5 mb-7">

          <!-- Círculo con ícono -->
          <div class="relative z-10 flex-shrink-0">
            <div
              class="w-11 h-11 rounded-full flex items-center justify-center"
              style="background: #fff; border: 1.5px solid #C9A545;
                     box-shadow: 0 0 0 3px rgba(201,165,69,0.09);"
            >
              <img
                src={`/imagenes/${ev.icon}.png`}
                alt={ev.nombre}
                class="icono-dorado"
                style="width: 1.65rem; height: 1.65rem;"
              />
            </div>
          </div>

          <!-- Contenido -->
          <div class="flex-1 min-w-0 pt-0.5">
            <div class="flex items-end gap-1.5">
              <span
                class="font-great-vibes"
                style="font-size: clamp(1.55rem, 7vw, 1.9rem); color: #C9A545; line-height: 1;"
              >
                {ev.hora}
              </span>
              <span
                class="font-great-vibes"
                style="font-size: 1rem; color: rgba(201,165,69,0.85); margin-bottom: 0.1rem;"
              >
                Hrs.
              </span>
            </div>
            <p
              class="font-crimson uppercase tracking-[0.14em]"
              style="font-size: clamp(0.82rem, 3.8vw, 0.96rem); font-weight: 700;
                     color: #C27587; line-height: 1.3; margin-top: 3px;"
            >
              {ev.nombre}
            </p>
            {i < eventos.length - 1 && (
              <div style="margin-top: 1.4rem; height: 1px; background-color: #F2D5DC;"></div>
            )}
          </div>

        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .icono-dorado {
    filter: invert(75%) sepia(35%) saturate(650%) hue-rotate(5deg) brightness(97%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const card = document.getElementById("itin-card");

  gsap.set("#itin-card",   { opacity: 0, y: 50 });
  gsap.set("#itin-header", { opacity: 0, scale: 0.88 });
  gsap.set(".itin-item",   { opacity: 0, x: -22 });

  let lastY = window.scrollY, bajando = true;
  window.addEventListener("scroll", () => {
    bajando = window.scrollY >= lastY;
    lastY = window.scrollY;
  }, { passive: true });

  function resetItin() {
    gsap.set("#itin-card",   { opacity: 0, y: 50 });
    gsap.set("#itin-header", { opacity: 0, scale: 0.88 });
    gsap.set(".itin-item",   { opacity: 0, x: -22 });
  }

  new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) {
        if (e.boundingClientRect.top > 0) resetItin();
        return;
      }
      if (!bajando) return;
      const tl = gsap.timeline();
      tl.to("#itin-card",   { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0)
        .to("#itin-header", { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" }, 0.15)
        .to(".itin-item",   { opacity: 1, x: 0, duration: 0.65, ease: "power2.out" }, 0.25);
    });
  }, { threshold: 0.15 }).observe(card!);
</script>
