---
---

<section class="relative w-full flex items-center justify-center py-16 px-5">

  <div id="rest-card"
    class="relative w-full max-w-xs mx-auto flex flex-col items-center text-center rounded-2xl shadow-2xl px-8 py-10"
    style="background-color: rgba(255,255,255,0.96);"
  >

    <!-- Título -->
    <h2 id="rest-titulo"
      class="font-crimson uppercase tracking-[0.2em] mb-5"
      style="font-size: clamp(1.1rem, 5vw, 1.4rem); font-weight: 700; color: #C9A545;"
    >Solo Adultos</h2>

    <!-- Ícono -->
    <div id="rest-icono" class="mb-5 flex items-center justify-center">
      <img src="/imagenes/restriccion.png" alt="Solo adultos"
        class="rest-icon w-16 h-16 object-contain" />
    </div>

    <!-- Línea separadora -->
    <div id="rest-sep" class="w-full mb-5" style="height: 1px; background-color: #F2D5DC;"></div>

    <!-- Texto principal -->
    <p id="rest-texto"
      class="font-raleway"
      style="font-size: clamp(0.95rem, 4.5vw, 1.05rem); font-weight: 300; color: #C27587; line-height: 1.8; font-style: italic;"
    >
      Amamos a sus pequeños, pero deseamos una celebración solo para adultos. ¡Gracias por su comprensión!
    </p>

  </div>
</section>

<style>
  .rest-icon {
    filter: brightness(0) saturate(100%) invert(68%) sepia(45%) saturate(700%) hue-rotate(10deg) brightness(95%);
  }
</style>

<script>
  import { gsap } from "gsap";

  const card = document.getElementById("rest-card");

  gsap.set("#rest-card",   { opacity: 0, y: 50 });
  gsap.set("#rest-titulo", { opacity: 0, scale: 0.85 });
  gsap.set("#rest-icono",  { opacity: 0, y: -20, scale: 0.7 });
  gsap.set("#rest-sep",    { opacity: 0, scaleX: 0 });
  gsap.set("#rest-texto",  { opacity: 0, y: 20 });

  let lastY = window.scrollY, bajando = true;
  window.addEventListener("scroll", () => { bajando = window.scrollY >= lastY; lastY = window.scrollY; }, { passive: true });

  function resetRest() {
    gsap.set("#rest-card",   { opacity: 0, y: 50 });
    gsap.set("#rest-titulo", { opacity: 0, scale: 0.85 });
    gsap.set("#rest-icono",  { opacity: 0, y: -20, scale: 0.7 });
    gsap.set("#rest-sep",    { opacity: 0, scaleX: 0 });
    gsap.set("#rest-texto",  { opacity: 0, y: 20 });
  }

  new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) {
        if (e.boundingClientRect.top > 0) resetRest();
        return;
      }
      if (!bajando) return;
      const tl = gsap.timeline();
      tl.to("#rest-card",   { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0)
        .to("#rest-titulo", { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" }, 0.1)
        .to("#rest-icono",  { opacity: 1, y: 0, scale: 1, duration: 0.7, ease: "back.out(1.5)" }, 0.2)
        .to("#rest-sep",    { opacity: 1, scaleX: 1, duration: 0.6, ease: "power2.out", transformOrigin: "left" }, 0.35)
        .to("#rest-texto",  { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 0.5);
    });
  }, { threshold: 0.2 }).observe(card!);
</script>
